<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Playnest</AssemblyName>
    <RootNamespace>Playnest</RootNamespace>
    <Version>1.2.2</Version>
    <Product>Playnest</Product>
    <Copyright>Copyright (c) 2026 Kishen (Random5386). MIT License.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\playnest.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Playnest is an app, not a library: no reference assembly (obj\refint) is needed. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- Low resource usage -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>

    <!-- The scanners only run on Windows; the analyzer is told so here so the code stays readable. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- NativeAOT publish (run publish.ps1 on Windows): single native exe, fastest startup, lowest RAM -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Playnest.Tests" />
  </ItemGroup>

</Project>
