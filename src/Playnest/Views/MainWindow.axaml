<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Playnest.ViewModels"
        xmlns:views="using:Playnest.Views"
        x:Class="Playnest.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Playnest"
        Icon="/Assets/playnest.ico"
        Width="1280" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">

  <Panel>
    <!-- Background layers (one is active depending on Settings → Appearance → Backdrop) -->
    <Border Name="SolidLayer" Background="{DynamicResource AppBackgroundBrush}" />
    <Image Name="ImageLayer" Stretch="UniformToFill" IsVisible="False" />

    <Grid RowDefinitions="40,*">
      <!-- Title bar (drag to move; Windows draws the caption buttons) -->
      <Border Name="TitleBar" Grid.Row="0" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="/Assets/playnest.png" Width="18" Height="18" />
          <TextBlock Text="Playnest" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScanning}" Margin="12,0,0,0">
            <ProgressBar IsIndeterminate="True" Width="60" MinWidth="60" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ScanStatus}" Classes="subtle small" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <!-- ============================== Sidebar ============================== -->
        <DockPanel Grid.Column="0" Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBrush}">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
            <Button Classes="nav" Classes.selected="{Binding IsLaunchersPage}" Command="{Binding ShowLaunchersCommand}"
                    ToolTip.Tip="Store launchers &amp; gaming tools">
              <Grid ColumnDefinitions="28,*">
                <Border Classes="indicator" />
                <TextBlock Classes="glyph" Text="&#xE719;" />
                <TextBlock Grid.Column="1" Text="Launchers &amp; tools" Margin="8,0,0,0" VerticalAlignment="Center"
                           IsVisible="{DynamicResource ShowSidebarText}" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.selected="{Binding IsSettingsPage}" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Settings">
              <Grid ColumnDefinitions="28,*">
                <Border Classes="indicator" />
                <TextBlock Classes="glyph" Text="&#xE713;" />
                <TextBlock Grid.Column="1" Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                           IsVisible="{DynamicResource ShowSidebarText}" />
              </Grid>
            </Button>
          </StackPanel>

          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Classes="section" IsVisible="{DynamicResource ShowSidebarText}" Margin="20,8,0,6" />

          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Filters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarItem">
                  <Panel>
                    <TextBlock Text="{Binding Label}" Classes="section" IsVisible="{Binding IsHeader}" Margin="20,14,0,4" />
                    <Button Classes="nav" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsHeader}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectFilterCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Label}">
                      <Grid ColumnDefinitions="28,*,Auto">
                        <Border Classes="indicator" />
                        <TextBlock Classes="glyph" Text="{Binding Glyph}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" IsVisible="{DynamicResource ShowSidebarText}" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="subtle small" VerticalAlignment="Center"
                                   IsVisible="{DynamicResource ShowSidebarCounts}" />
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- ============================== Pages ============================== -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBrush}" CornerRadius="10,0,0,0" ClipToBounds="True"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,0,0">
          <Panel>
            <views:LibraryView Name="LibraryPage" IsVisible="{Binding IsLibraryPage}" />
            <views:LaunchersView IsVisible="{Binding IsLaunchersPage}" />
            <Panel IsVisible="{Binding IsSettingsPage}">
              <views:SettingsView DataContext="{Binding SettingsPage}" />
            </Panel>
          </Panel>
        </Border>

        <!-- ============================== Details ============================== -->
        <views:DetailsPanel Grid.Column="2" Width="340" IsVisible="{Binding IsDetailsOpen}" />
      </Grid>

      <!-- ============================== Toast ============================== -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,22" IsVisible="{Binding CurrentToast, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:Toast">
            <Border Background="{DynamicResource ToastBrush}" CornerRadius="10" Padding="16,10" MaxWidth="640"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" BoxShadow="0 8 24 0 #40000000">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="glyph" Text="&#xE783;" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsError}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="460" VerticalAlignment="Center" />
                <Button Content="{Binding ActionText}" IsVisible="{Binding HasAction}" Command="{Binding RunActionCommand}" Classes="accent" />
                <Button Classes="flat" Padding="6" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DismissToastCommand}">
                  <TextBlock Classes="glyph" Text="&#xE711;" FontSize="11" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </Panel>
</Window>
