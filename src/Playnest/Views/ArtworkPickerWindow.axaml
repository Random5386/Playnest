<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Playnest.ViewModels"
        x:Class="Playnest.Views.ArtworkPickerWindow"
        x:DataType="vm:ArtworkPickerViewModel"
        Title="{Binding Title}"
        Width="900" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DialogBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}">

  <DockPanel>
    <!-- Buttons -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Your choice is kept as this game's own artwork, even when all artwork is replaced."
                   Classes="subtle small" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center" />
          <Button Name="UseButton" Content="Use this" Classes="accent" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center"
                  IsEnabled="{Binding HasChoice}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Game, kind and search -->
    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,10" Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="h2" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Artwork from SteamGridDB" Classes="subtle small" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,12,*,8,220,8,Auto" IsEnabled="{Binding HasKey}">
        <ComboBox ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" MinWidth="130" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" HorizontalAlignment="Stretch"
                  PlaceholderText="Game on SteamGridDB">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ArtworkPickerGame">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="4" Name="SearchBox" Text="{Binding SearchText}" Watermark="Search another name" />
        <Button Grid.Column="6" Content="Search" Command="{Binding SearchCommand}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="60" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="subtle small" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>

    <!-- Images -->
    <!-- Margin on the list, not Padding on the ScrollViewer: a ScrollViewer's Padding isn't part of its scroll range. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Options}" Margin="24,0,10,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ArtworkOption">
            <Button Classes="tile pick" Classes.selected="{Binding IsSelected}" Margin="0,0,12,12" Padding="0"
                    Width="{Binding TileWidth}" ToolTip.Tip="{Binding SizeText}">
              <StackPanel Spacing="4">
                <Border Classes="art" Width="{Binding TileWidth}" Height="{Binding TileHeight}" Background="{DynamicResource CardBrush}">
                  <Panel>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding SizeText}" Classes="subtle small" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
